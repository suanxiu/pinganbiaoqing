.preview-page { box-sizing: border-box; min-height: 100vh; padding: 22rpx 28rpx 38rpx; background: #28231f; }
.preview-stage { position: relative; width: 100%; min-height: 740rpx; overflow: hidden; background: #eee4d5; }
.render-canvas { position: absolute; left: -2000rpx; top: 0; width: 750px; height: 1000px; }
.result-image { display: block; width: 100%; height: auto; }
.rendering-state { display: flex; min-height: 740rpx; align-items: center; justify-content: center; padding: 40rpx; box-sizing: border-box; color: #fff9ef; text-align: center; font-size: 34rpx; line-height: 1.6; }
.preview-copy { padding: 22rpx 4rpx; color: #fff9ef; }.preview-label { display: block; color: #d9a441; font-size: 26rpx; }.preview-text { display: block; margin-top: 10rpx; font-size: 30rpx; line-height: 1.5; }
.preview-actions { display: flex; flex-direction: column; gap: 14rpx; }.preview-actions button { margin: 0; }.green-button { min-height: 100rpx; background: #2f6650; color: #fff; line-height: 100rpx; }.quiet-button { min-height: 88rpx; background: #544a43; color: #fff9ef; line-height: 88rpx; font-size: 30rpx; }.preview-links { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }.preview-links button { min-height: 78rpx; margin: 0; background: transparent; color: #e6cf95; font-size: 28rpx; line-height: 78rpx; border: 2rpx solid #776b61; }
