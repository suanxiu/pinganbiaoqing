<view class="preview-page">
  <view class="preview-stage">
    <canvas canvas-id="previewCanvas" class="render-canvas" width="750" height="1000"></canvas>
    <image wx:if="{{imagePath}}" class="result-image" src="{{imagePath}}" mode="widthFix"></image>
    <view wx:elif="{{rendering}}" class="rendering-state">正在生成一张可分享的精品图...</view>
    <view wx:else class="rendering-state">{{motionMessage}}</view>
  </view>
  <view class="preview-copy" wx:if="{{draft}}"><text class="preview-label">{{draft.period}} · {{draft.theme}}</text><text class="preview-text">{{draft.copy}}</text></view>
  <view class="preview-actions"><button class="primary-button" loading="{{saving}}" bindtap="saveImage">保存到手机</button><button class="green-button" bindtap="shareImage">分享图片</button><button class="quiet-button" bindtap="makeMotion">{{motionState === 'loading' ? '准备中' : '做成动态照片'}}</button></view>
  <view class="preview-links"><button bindtap="goAlbum">查看相册</button><button bindtap="goCreate">换一张照片</button></view>
</view>
