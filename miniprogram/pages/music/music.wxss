.music-banner { min-height: 300rpx; margin-top: 28rpx; padding: 46rpx 38rpx; background: #2f6650; color: #fff; }.music-banner-small,.music-banner-title { display: block; }.music-banner-small { color: #e6cf95; font-size: 28rpx; }.music-banner-title { width: 82%; margin-top: 44rpx; font-size: 46rpx; font-weight: 700; line-height: 1.5; }.song-list { display: flex; margin-top: 28rpx; flex-direction: column; gap: 18rpx; }.song-item { display: grid; grid-template-columns: 76rpx 1fr; width: 100%; min-height: 132rpx; margin: 0; padding: 22rpx 26rpx; align-items: center; background: #fff; color: #28231f; text-align: left; border: 2rpx solid #e0d6ca; }.play-mark { color: #b9342b; font-size: 38rpx; }.song-copy,.song-title,.song-rights { display: block; }.song-title { font-size: 34rpx; font-weight: 700; }.song-rights { margin-top: 8rpx; color: #776e66; font-size: 25rpx; }
