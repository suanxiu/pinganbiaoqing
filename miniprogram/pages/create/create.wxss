.step-title { display: block; margin: 42rpx 0 20rpx; font-size: 36rpx; font-weight: 700; }
.step-number { display: inline-flex; width: 48rpx; height: 48rpx; margin-right: 16rpx; align-items: center; justify-content: center; background: #2f6650; color: #fff; font-size: 28rpx; }
.photo-picker { width: 100%; height: 480rpx; margin: 0; padding: 0; overflow: hidden; background: #eee4d5; color: #5f554c; border: 3rpx dashed #b9aa98; }
.photo-preview { width: 100%; height: 100%; }
.photo-empty { display: flex; height: 100%; align-items: center; justify-content: center; flex-direction: column; gap: 20rpx; }
.add-mark { color: #b9342b; font-size: 76rpx; font-weight: 400; }
.copy-list { display: flex; flex-direction: column; gap: 16rpx; }
.copy-option { box-sizing: border-box; width: 100%; min-height: 104rpx; margin: 0; padding: 22rpx 26rpx; background: #fff; color: #3d3732; text-align: left; line-height: 1.5; border: 2rpx solid #ddd2c5; }
.copy-option-active { border: 4rpx solid #b9342b; color: #8e261f; }
