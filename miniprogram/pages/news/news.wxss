.news-sheet { min-height: 780rpx; padding: 52rpx 42rpx; background: #fffdf8; border-top: 10rpx solid #b9342b; box-shadow: 0 16rpx 40rpx rgba(55,42,31,.12); }.news-kicker,.news-title { display: block; }.news-kicker { color: #2f6650; font-size: 28rpx; font-weight: 700; }.news-title { margin-top: 12rpx; font-size: 58rpx; font-weight: 700; }.news-rule { width: 120rpx; height: 8rpx; margin: 32rpx 0 20rpx; background: #d9a441; }.news-item { display: grid; grid-template-columns: 68rpx 1fr; padding: 28rpx 0; border-bottom: 2rpx solid #e9dfd3; }.news-number { color: #b9342b; font-size: 30rpx; font-weight: 700; }.news-copy { font-size: 34rpx; line-height: 1.65; }.news-source { display: block; margin-top: 28rpx; color: #847b73; font-size: 25rpx; }.news-share { margin-top: 28rpx; }
