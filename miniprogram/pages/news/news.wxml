<view class="page-shell"><view class="news-sheet"><text class="news-kicker">每日简报</text><text class="news-title">{{digest.dateLabel}}</text><view class="news-rule"></view><view wx:for="{{digest.items}}" wx:key="*this" class="news-item"><text class="news-number">0{{index + 1}}</text><text class="news-copy">{{item}}</text></view><text class="news-source">正式版将显示来源、发布日期和审核状态</text></view><button class="primary-button news-share" open-type="share">分享这张新闻图</button></view>
