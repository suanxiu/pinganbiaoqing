.shop-header { padding-bottom: 22rpx; border-bottom: 4rpx solid #2f6650; }.category-scroll { margin: 28rpx 0; white-space: nowrap; }.category-row { display: inline-flex; gap: 14rpx; }.category-item { height: 76rpx; margin: 0; padding: 0 28rpx; background: #fff; color: #5e554e; font-size: 29rpx; line-height: 76rpx; border: 2rpx solid #ded3c6; }.category-active { background: #2f6650; color: #fff; border-color: #2f6650; }.product-list { display: flex; flex-direction: column; gap: 20rpx; }.product-item { display: grid; grid-template-columns: 190rpx 1fr; width: 100%; min-height: 230rpx; margin: 0; padding: 0; overflow: hidden; background: #fff; text-align: left; border: 2rpx solid #e0d6ca; }.product-art { display: flex; align-items: center; justify-content: center; background: #e5dccb; color: #6c5a45; font-size: 26rpx; }.product-main { display: flex; padding: 25rpx 28rpx; flex-direction: column; }.product-tag { align-self: flex-start; padding: 5rpx 14rpx; background: #f2e1d2; color: #97362f; font-size: 24rpx; }.product-title { margin-top: 14rpx; font-size: 34rpx; font-weight: 700; }.product-price { margin-top: auto; color: #b9342b; font-size: 38rpx; font-weight: 700; }.shop-note { display: block; margin: 32rpx 0; color: #766e67; font-size: 27rpx; line-height: 1.6; }
