.empty-title,.empty-copy { display: block; }.empty-title { color: #28231f; font-size: 40rpx; font-weight: 700; }.empty-copy { margin: 20rpx 0 36rpx; line-height: 1.6; }.empty-button { width: 72%; }
.work-list { display: flex; margin-top: 28rpx; flex-direction: column; gap: 24rpx; }.work-item { display: grid; grid-template-columns: 210rpx 1fr; overflow: hidden; background: #fff; border: 2rpx solid #e2d7ca; }.work-image { width: 210rpx; height: 290rpx; }.work-info { display: flex; min-width: 0; padding: 24rpx; flex-direction: column; }.work-date { color: #2f6650; font-size: 26rpx; }.work-copy { display: -webkit-box; margin-top: 16rpx; overflow: hidden; font-size: 30rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.work-actions { display: flex; margin-top: auto; gap: 12rpx; }.work-actions button { height: 70rpx; margin: 0; padding: 0 24rpx; font-size: 28rpx; line-height: 70rpx; }.work-share { background: #2f6650; color: #fff; }.work-delete { background: #f4eee5; color: #7e4039; }
