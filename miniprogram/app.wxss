page { background: #fff9ef; color: #28231f; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 32rpx; }
button { border-radius: 12rpx; font-size: 34rpx; font-weight: 600; letter-spacing: 0; }
button::after { border: 0; }
.page-shell { box-sizing: border-box; min-height: 100vh; padding: 28rpx 28rpx 48rpx; }
.page-title { display: block; margin: 4rpx 0 8rpx; font-size: 48rpx; font-weight: 700; }
.page-subtitle { display: block; color: #6e665f; font-size: 30rpx; line-height: 1.6; }
.section-title { display: block; margin: 40rpx 0 20rpx; font-size: 38rpx; font-weight: 700; }
.primary-button { min-height: 100rpx; background: #b9342b; color: #fff; line-height: 100rpx; }
.muted { color: #766e67; }
.empty-state { padding: 80rpx 36rpx; text-align: center; color: #6e665f; }
